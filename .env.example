# 复制为 .env 后填写：cp .env.example .env
# .env 已在 .gitignore 里，不会进仓库。终端里 export 的同名变量优先于这里。

# 阿里云百炼（中国内地 · 北京地域）
LLM_API_KEY=
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-flash
LLM_JUDGE_MODEL=qwen-plus

# 微信小程序（可选）：配置后身份强制用 openid，并启用微信内容安全检查 msgSecCheck
# WX_APPID=
# WX_APPSECRET=

# 网页后台 /admin 的管理员密码（不设则后台关闭）
# ADMIN_PASSWORD=

# 内测白名单（可选）：逗号分隔的 openid（只支持 openid，设备 ID 不生效）。仅首次启动作种子写入库，
# 之后在后台 /admin「内测白名单」卡片在线增删（即时生效），改这里不再生效
# LIMIT_WHITELIST=

# 每身份每日分析次数（默认 3）。仅首次启动作种子；之后在后台「运行参数」卡片在线调整
# ANALYZE_PER_IDENTITY_PER_DAY=3
# 后台账号（可选）：与 ADMIN_PASSWORD 同时配置才启用「账号+密码」登录，只配密码则不校验账号
# ADMIN_USERNAME=
