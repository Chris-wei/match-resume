/* ---------- 首屏 ---------- */
.hero {
  margin: 12rpx 28rpx 0;
  padding: 48rpx 40rpx 40rpx;
  border-radius: 32rpx;
  background:
    radial-gradient(120% 80% at 100% 0%, rgba(59, 91, 253, 0.16) 0%, rgba(59, 91, 253, 0) 60%),
    linear-gradient(180deg, #ffffff 0%, #f8f9ff 100%);
  box-shadow: var(--shadow);
}

.hero-eyebrow {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--primary);
  background: var(--primary-soft);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  letter-spacing: 1rpx;
}

.hero-title {
  margin-top: 24rpx;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 1rpx;
}

.hero-accent {
  display: block;
  color: var(--primary);
}

.hero-sub {
  margin-top: 16rpx;
  font-size: 27rpx;
  color: var(--text-2);
  line-height: 1.7;
}

.hero-points {
  margin-top: 24rpx;
}

.hero-point {
  display: flex;
  align-items: center;
  font-size: 25rpx;
  color: var(--text-2);
  padding: 4rpx 0;
}

.hp-icon {
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 50%;
  background: var(--green-bg);
  color: var(--green);
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.hero-cta {
  margin-top: 36rpx;
}

.hero-quota {
  margin-top: 18rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
}

.hero-quota-num {
  color: var(--primary);
  font-weight: 600;
}

/* ---------- 我的报告 ---------- */
.report-item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 20rpx 12rpx;
  margin: 0 -12rpx;
  border-radius: var(--radius-sm);
}

.report-item {
  border-top: 1rpx solid var(--line);
}

.report-item:first-child {
  border-top: none;
}

.report-item-hover {
  background: var(--gray-bg);
}

.report-score {
  width: 84rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 22rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.lvl-high { background: var(--green-bg); color: var(--green); }
.lvl-mid { background: var(--orange-bg); color: var(--orange); }
.lvl-low { background: var(--red-bg); color: var(--red); }

.report-info {
  flex: 1;
  min-width: 0;
}

.report-conclusion {
  font-size: 26rpx;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 2rpx;
}

.chevron {
  color: var(--text-3);
  font-size: 36rpx;
  flex-shrink: 0;
}

/* ---------- 示例报告 ---------- */
.sample-row {
  display: flex;
  align-items: center;
}

.ring {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ring-inner {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ring-num {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--primary);
}

.ring-label {
  font-size: 20rpx;
  color: var(--text-3);
}

.sample-radar {
  flex: 1;
  min-width: 0;
}

.sample-list {
  margin-top: 8rpx;
  border-top: 1rpx solid var(--line);
  padding-top: 16rpx;
}

.sample-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0;
}

.sample-text {
  font-size: 26rpx;
  color: var(--text-2);
}

/* ---------- 步骤 ---------- */
.step {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  padding: 12rpx 0;
  position: relative;
}

.step::before {
  content: '';
  position: absolute;
  left: 25rpx;
  top: -18rpx;
  height: 28rpx;
  border-left: 2rpx dashed var(--primary-line);
}

.step:first-child::before {
  display: none;
}

.step-num {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
  flex-shrink: 0;
}

.step-h {
  font-size: 28rpx;
  font-weight: 600;
}

/* ---------- 页脚 ---------- */
.footer {
  text-align: center;
  padding: 24rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  line-height: 1.9;
}

.footer-links {
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 4rpx;
}

.footer-links text:active {
  opacity: 0.6;
}

.footer-note {
  font-size: 21rpx;
  color: var(--text-3);
}
