.page {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.title-num {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 12rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  margin-right: 14rpx;
}

.aside.over {
  color: var(--orange);
}

/* ---------- 工具条 ---------- */
.tool-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.tool {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 25rpx;
  color: var(--primary);
  background: var(--primary-soft);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}

.tool-muted {
  color: var(--text-2);
  background: var(--gray-bg);
  margin-left: auto;
}

.tool-hover {
  opacity: 0.7;
}

.tool-icon {
  font-size: 26rpx;
}

/* ---------- 输入区 ---------- */
.input-area {
  width: 100%;
  height: 360rpx;
  background: var(--gray-bg);
  border-radius: var(--radius-sm);
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--text);
}

.input-area.jd {
  height: 280rpx;
}

.input-static {
  overflow: hidden;
  white-space: pre-wrap;
  word-break: break-all;
}

.ph {
  color: var(--text-3);
}

.privacy-tip {
  text-align: center;
  font-size: 23rpx;
  color: var(--text-3);
  padding: 8rpx 40rpx 0;
}

/* ---------- 底部提交栏 ---------- */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 18rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -6rpx 24rpx rgba(17, 24, 39, 0.06);
}

.submit-meta {
  text-align: center;
  font-size: 23rpx;
  color: var(--text-3);
  margin-bottom: 14rpx;
}

.submit-meta .em {
  color: var(--primary);
  font-weight: 600;
}

/* ---------- 隐私确认 ---------- */
.dialog {
  width: 640rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 44rpx 40rpx 40rpx;
  box-sizing: border-box;
  animation: pop-in 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.dialog-icon {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  text-align: center;
  font-size: 40rpx;
  margin: 0 auto 16rpx;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
}

.dialog-line {
  position: relative;
  padding-left: 28rpx;
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.7;
  margin-bottom: 12rpx;
}

.dialog-line::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 16rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--primary);
}

.dialog-link {
  font-size: 25rpx;
  color: var(--primary);
  margin-top: 8rpx;
}

.dialog-check {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 28rpx 0 24rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

.dialog-check checkbox {
  transform: scale(0.8);
}

@keyframes pop-in {
  from { transform: scale(0.94); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

/* ---------- 分析进度 ---------- */
.progress {
  width: 600rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 44rpx 40rpx;
  box-sizing: border-box;
  animation: pop-in 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.progress-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
}

.progress-sub {
  font-size: 23rpx;
  color: var(--text-3);
  text-align: center;
  margin: 6rpx 0 36rpx;
}

.pstep {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 14rpx 0;
  position: relative;
}

.pstep::before {
  content: '';
  position: absolute;
  left: 19rpx;
  top: -14rpx;
  height: 28rpx;
  border-left: 2rpx solid var(--line);
}

.pstep:first-child::before {
  display: none;
}

.pstep-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
  box-sizing: border-box;
}

.pstep-text {
  font-size: 28rpx;
}

.pstep-todo .pstep-dot { border: 3rpx solid var(--line); }
.pstep-todo .pstep-text { color: var(--text-3); }
.pstep-active .pstep-dot { background: var(--primary-soft); }
.pstep-active .pstep-text { color: var(--text); font-weight: 600; }
.pstep-done .pstep-dot { background: var(--green); color: #fff; }
.pstep-done .pstep-text { color: var(--text-2); }

.spinner {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  border: 4rpx solid var(--primary-line);
  border-top-color: var(--primary);
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.progress-tip {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
  font-size: 23rpx;
  color: var(--text-3);
  text-align: center;
}
